# Config for scripts/maintenance/rotate-public-ip.sh
# Copy to config/ip-rotation.env (gitignored) and fill in.

# OCID of the instance whose public IP gets rotated (required).
#   oci compute instance list --compartment-id <compartment> \
#     --query 'data[].{name:"display-name",id:id}'
INSTANCE_OCID=

# SSH alias used to verify the VM came back (optional).
# Must reach the VM over the Cloudflare tunnel, not the public IP.
SSH_HOST=

# OCI CLI profile holding the session token (optional).
#   oci session authenticate --region <region> --profile-name DEFAULT
OCI_PROFILE=DEFAULT

# Region for newly created reserved IPs (optional, defaults to the instance's).
OCI_REGION=
